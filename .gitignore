# ===== KiCad =====
# Backups and autosave files
*-backups/
_autosave-*
*.bak
*.kicad_sch-bak
*.kicad_pcb-bak
*.sch-bak
\#auto_saved_files\#

# Lock files (created while a project is open)
*.lck
~*.lck

# Footprint library cache
fp-info-cache

# Local view settings (layers, zoom) - differ on every machine
*.kicad_prl

# Generated fabrication outputs - regenerate them from the project
# and publish ready-to-order packages under GitHub Releases
hardware/production/
hardware/gerbers/
*.zip

# ===== Firmware (PlatformIO) =====
.pio/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# Credentials (Wi-Fi, MQTT) - NEVER commit them.
# Keep only the secrets.example.h template in the repository.
firmware/include/secrets.h
.env

# ===== Web dashboard / tooling =====
node_modules/
dist/
__pycache__/
*.pyc
.venv/

